{
  "name": "cliproxy-rs-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" scripts/private-auth-dir.test.mjs",
    "lint": "node tools/lint.mjs",
    "format": "prettier --write .",
    "check:api": "node tools/check-api.mjs",
    "check:i18n": "node tools/check-i18n.mjs",
    "check:ui": "node tools/check-ui.mjs",
    "knip": "knip",
    "check:astryx": "astryx doctor --built dist-next",
    "check:size": "node tools/size.mjs",
    "check": "node tools/check-all.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@fontsource/figtree": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "intl-messageformat": "12.1.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@eslint/js": "10.0.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.44.2",
    "opencc-js": "1.4.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
